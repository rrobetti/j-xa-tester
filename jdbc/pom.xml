<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.rrobetti</groupId>
    <artifactId>j-xa-tester</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>xa-tester-jdbc</artifactId>
  <name>J XA Tester - JDBC Adapter</name>
  <description>
    Wraps javax.sql.XADataSource/XAConnection so ordinary and recovery JDBC
    connections hand out a fault-injecting XAResource automatically. Main
    code depends only on the JDK (java.sql); H2 is a test-only dependency
    used as a real XA-capable database for the adapter's tests.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.github.rrobetti</groupId>
      <artifactId>xa-tester-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
