<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.rrobetti</groupId>
    <artifactId>j-xa-tester</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>xa-tester-core</artifactId>
  <name>J XA Tester - Core</name>
  <description>
    Decorates javax.transaction.xa.XAResource instances, records ordered XA
    events, and applies once-only fault-injection rules. Depends only on the
    JDK (java.transaction.xa); every non-JDK dependency below is test-scoped.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
